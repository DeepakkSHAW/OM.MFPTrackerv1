@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using OM.MFPTrackerV1.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Login</PageTitle>

<AuthorizeView>
    <NotAuthorized Context="authState">
        <div class="login-page">
            <div class="login-card">
                <div class="login-brand mb-4">
                    <div class="login-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div>
                        <h3 class="mb-1">Sign in</h3>
                        <div class="text-muted small">
                            Access your mutual fund portfolio dashboard
                        </div>
                    </div>
                </div>

                @if (HasError)
                {
                    <div class="alert alert-danger py-2">
                        @ErrorMessage
                    </div>
                }

                <EditForm Model="Model" OnValidSubmit="RSLogin">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Username</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <InputText class="form-control" autocomplete="username" @bind-Value="Model.Username" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-key"></i>
                            </span>
                            <InputText type="password" class="form-control" autocomplete="current-password" @bind-Value="Model.Password" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 login-button">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Sign in
                    </button>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(EffectiveReturnUrl) && EffectiveReturnUrl != "/")
                {
                    <div class="text-muted small text-center mt-3">
                        You will return to your requested page after sign in.
                    </div>
                }
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
<style>
    .login-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 2rem 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        padding: 2rem;
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 0.75rem;
        background: #fff;
        box-shadow: 0 1rem 2.5rem rgba(15, 23, 42, 0.10);
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .login-icon {
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
        background: #eef6ff;
        color: #0d6efd;
        font-size: 1.35rem;
    }

    .login-button {
        font-weight: 600;
    }
</style>

@code {
    //private LoginRequest Model { get; } = new();
    private LoginRequest Model { get; } = new LoginRequest { Username = "deepak", Password = "Admin@123" };//only for testing, remove default values in production "Admin@123!

    private string? ErrorMessage;
    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);


    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrlPascal { get; set; }

    private string EffectiveReturnUrl
    {
        get
        {
            var returnUrl = !string.IsNullOrWhiteSpace(ReturnUrl)
                ? ReturnUrl!
                : !string.IsNullOrWhiteSpace(ReturnUrlPascal)
                    ? ReturnUrlPascal!
                    : "/";

            return IsSafeLocalUrl(returnUrl)
                ? returnUrl
                : "/";
        }
    }

    private static bool IsSafeLocalUrl(string url) =>
        url.StartsWith('/') &&
        !url.StartsWith("//") &&
        !url.Contains("://", StringComparison.Ordinal);



    private async Task RSLogin()
    {
        ErrorMessage = null;

        var result = await JS.InvokeAsync<LoginResult>(
            "auth.alogin",
            Model.Username,
            Model.Password,
            EffectiveReturnUrl
        );

        if (!result.Success)
        {
            ErrorMessage = result.Reason switch
            {
                "maintenance" => "Login is temporarily disabled due to maintenance. Please try again later.",
                "invalid" => "Invalid username or password.",
                _ => "An unexpected error occurred. Please try again later."
            };

            return;
        }
        // ✅ success
        var redirectUrl = !string.IsNullOrWhiteSpace(result.RedirectUrl)
            ? result.RedirectUrl
            : EffectiveReturnUrl;

        Navigation.NavigateTo(string.IsNullOrWhiteSpace(redirectUrl) ? "/" : redirectUrl, forceLoad: true);

    }

}