@page "/"
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@using OM.MFPTrackerV1.Data.Services

@inject ISystemStateRepo SystemStateRepo
@inject IFolioRepo FolioRepo
@inject IMFFundRepo FundRepo
@inject IMutualFundTransactionRepo TxnRepo
@inject IPortfolioReturnService PortfolioReturnService
@inject ILogger<Home> Logger

<PageTitle>Home</PageTitle>

<div class="container py-2">

    <!-- ==================================================
         Header Section
         ================================================== -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-3 mb-3">
        <div>
            <h1 class="h3 mb-1">
                Mutual Fund Portfolio Tracker
            </h1>

            <div class="text-muted small">
                Portfolio insights, transactions and performance tracking
            </div>
        </div>

        <div class="text-muted small text-md-end">
            @if (lastNavSyncUtc.HasValue)
            {
                <div>
                    <i class="bi bi-cloud-check me-1"></i>
                    NAV Sync:
                    @(lastNavSyncUtc.Value.ToLocalTime().ToString("dd-MMM-yyyy HH:mm"))
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(appName))
            {
                <div>
                    @appName v@(appVersion)
                </div>
            }
        </div>
    </div>

    <!-- ==================================================
         Dashboard Cards
         ================================================== -->
    <div class="row g-3">

        <!-- ==============================================
             Card 1 : Portfolio Snapshot
             ============================================== -->
        <div class="col-md-6 order-3 order-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="fw-semibold mb-3">
                        <i class="bi bi-speedometer2 me-2"></i>
                        Portfolio Snapshot
                    </div>

                    <div class="d-flex flex-wrap gap-3 mb-2">
                        <span>
                            <i class="bi bi-collection text-primary me-2"></i>
                            Folios:
                            <span class="fw-bold">@totalFolios</span>
                        </span>

                        <span>
                            <i class="bi bi-bank text-success me-2"></i>
                            Unique Funds:
                            <span class="fw-bold">@totalFunds</span>
                        </span>
                    </div>

                    <div class="mb-2">
                        <i class="bi bi-cash-stack text-warning me-2"></i>
                        Total Investment (Cost Value):
                        <span class="fw-bold">
                            ₹@totalInvestment.ToString("N0")
                        </span>
                    </div>

                    <div>
                        <i class="bi bi-graph-up-arrow text-info me-2"></i>
                        Total Investment (Current Value):
                        <span class="fw-bold">
                            ₹@totalCurrentValue.ToString("N0")
                        </span>
                    </div>

                    <div class="mt-2">
                        <i class="bi bi-percent text-danger me-2"></i>
                        Portfolio XIRR:
                        <span class="fw-bold">
                            @PortfolioXirrText
                        </span>
                    </div>

                </div>
            </div>
        </div>
        <!-- ==============================================
        Card 2 : Top 5 Holdings
        ============================================== -->
        <div class="col-md-6 order-4 order-md-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-trophy text-warning me-2"></i>

                        <span class="fw-semibold">
                            Top 5 Holdings
                        </span>
                    </div>

                    @if (!topHoldings.Any())
                    {
                        <div class="text-muted small">
                            No data available
                        </div>
                    }
                    else
                    {
                        @foreach (var fund in topHoldings)
                        {
                            <div class="d-flex justify-content-between mb-1">

                                <span class="text-truncate"
                                      style="max-width:220px;"
                                      title="@fund.FundName">
                                    @ShortFundName(fund.FundName)
                                </span>

                                <span class="fw-semibold text-primary">
                                    @fund.AllocationPct.ToString("N1")%
                                </span>

                            </div>
                        }
                    }

                </div>

            </div>
        </div>
             <!-- ==============================================
             Card 3 : Portfolio Value Trend
             ============================================== -->
        <div class="col-md-6 order-1 order-md-1">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-activity text-primary me-2"></i>

                        <span class="fw-semibold">
                            Portfolio Value Trend
                        </span>
                    </div>

                    @if (valueTrendLabels.Length == 0)
                    {
                        <div class="text-muted small">
                            No data available
                        </div>
                    }
                    else
                    {
                        <TwoLineChart Labels="valueTrendLabels"
                                      FirstData="investmentTrendData"
                                      SecondData="currentValueTrendData"
                                      FirstLabel="Total Investment"
                                      SecondLabel="Current Value" />
                    }

                </div>

            </div>
        </div>

        <!-- ==============================================
          Card 4 : Top Fund Performance
          ============================================== -->
        <div class="col-md-6 order-2 order-md-2">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-stars text-success me-2"></i>

                        <span class="fw-semibold">
                            Top 3 Fund Performance
                        </span>
                    </div>

                    @if (fundPerformanceSeriesLabels.Length == 0)
                    {
                        <div class="text-muted small">
                            No data available
                        </div>
                    }
                    else
                    {
                        <MultiLineChart Labels="fundPerformanceLabels"
                                        SeriesLabels="fundPerformanceSeriesLabels"
                                        SeriesData="fundPerformanceSeriesData"
                                        ValueSuffix="%" />
                    }

                </div>

            </div>
        </div>

    </div>

</div>

@code {

    // =====================================================
    // Application Metadata
    // =====================================================

    private string appName = "";
    private string appVersion = "";
    private DateTime? lastNavSyncUtc;

    // =====================================================
    // Portfolio Snapshot KPIs
    // =====================================================

    private int totalFolios;
    private int totalFunds;
    private decimal totalInvestment;
    private decimal totalCurrentValue;
    private decimal? portfolioXirr;

    private string PortfolioXirrText => portfolioXirr.HasValue
        ? (portfolioXirr.Value * 100).ToString("0.00") + "%"
        : "N/A";

    // =====================================================
    // Top Holdings Model
    // =====================================================

    private sealed class TopHolding
    {
        public string FundName { get; set; } = "";
        public decimal AllocationPct { get; set; }
    }

    private List<TopHolding> topHoldings = new();

    // =====================================================
    // Portfolio Value Trend
    // =====================================================

    private string[] valueTrendLabels = [];
    private double[] investmentTrendData = [];
    private double[] currentValueTrendData = [];

    private string[] fundPerformanceLabels = [];
    private string[] fundPerformanceSeriesLabels = [];
    private double[][] fundPerformanceSeriesData = [];

    private static string ShortFundName(string fundName, int maxLength = 34)
    {
        if (string.IsNullOrWhiteSpace(fundName) || fundName.Length <= maxLength)
            return fundName;

        return fundName[..(maxLength - 3)] + "...";
    }

    // =====================================================
    // Page Initialisation
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // -------------------------------------------------
        // Application Information
        // -------------------------------------------------

        var appInfo = await SystemStateRepo.GetAppInfoAsync();

        if (appInfo.HasValue)
        {
            appName = appInfo.Value.AppName;
            appVersion = appInfo.Value.AppVersion;
        }

        lastNavSyncUtc =
            await SystemStateRepo.GetLastNavSyncUtcAsync();

        // -------------------------------------------------
        // Portfolio Snapshot
        // -------------------------------------------------

        var folioResult =
            await FolioRepo.GetAsync(
                null,
                null,
                false,
                1,
                1);

        totalFolios =
            folioResult.TotalCount;

        var fundResult =
            await FundRepo.GetAsync(
                null,
                null,
                false,
                1,
                1);

        totalFunds =
            fundResult.TotalCount;

        // -------------------------------------------------
        // Fund Summary
        // -------------------------------------------------

        var summary =
            await TxnRepo.GetFundSummaryAsync();

        totalInvestment =
            summary.Sum(x => x.TotalInvestment);

        totalCurrentValue =
            summary.Sum(x => x.CurrentValue);

        try
        {
            portfolioXirr =
                await PortfolioReturnService.CalculateOverallXirrAsync();

            var valueTrend =
                await PortfolioReturnService.GetLast12MonthPortfolioValueTrendAsync();

            valueTrendLabels = valueTrend
                .Select(x => x.Month.ToString("MMM-yy"))
                .ToArray();

            investmentTrendData = valueTrend
                .Select(x => (double)x.TotalInvestment)
                .ToArray();

            currentValueTrendData = valueTrend
                .Select(x => (double)x.CurrentValue)
                .ToArray();

            var fundPerformance =
                await PortfolioReturnService.GetTopFundPerformanceTrendLast12MonthsAsync();

            fundPerformanceLabels = fundPerformance
                .FirstOrDefault()?
                .Points
                .Select(x => x.Month.ToString("MMM-yy"))
                .ToArray() ?? [];

            fundPerformanceSeriesLabels = fundPerformance
                .Select(x => ShortFundName(x.FundName, 18))
                .ToArray();

            fundPerformanceSeriesData = fundPerformance
                .Select(x => x.Points
                    .Select(p => (double)p.ReturnPercent)
                    .ToArray())
                .ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load portfolio return trend for the Home page.");
        }

        // -------------------------------------------------
        // Top 5 Holdings by Allocation
        // -------------------------------------------------

        topHoldings = summary
            .OrderByDescending(x => x.TotalInvestment)
            .Take(5)
            .Select(x => new TopHolding
            {
                FundName = x.FundName,

                AllocationPct = totalInvestment == 0
                    ? 0
                    : (x.TotalInvestment / totalInvestment) * 100
            })
            .ToList();
    }
}